!.gitignore

!git/**
!git/.*
!aerospace/**
!borders/**
!yabai/**
!skhd/**
!python/**
!starship/**
!bat/**
!yazi/**

!neovim/**
neovim/**/undodir

!zsh/**/.*
zsh/**/.antidote
zsh/**/.zhistory
zsh/**/.zsh_history
zsh/**/.zsh_history.LOCK
zsh/**/.zsh_plugins.zsh
zsh/**/.zsh_sessions

# Machine-specific generated files (not stowed, created at runtime)
git/.config/git/config.local
git/.config/git/ignore.merged

# tpm is a submodule; the rest are installed by tpm at runtime
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/tpm
tmux/.config/tmux/resurrect/

# Colima/Lima VM runtime state, not config
colima/.config/colima/_lima/
colima/.config/colima/_store/
colima/.config/colima/default/
colima/.config/colima/ssh_config

# The negations above outrank the global ignore; re-ignore these.
**/.claude/settings.local.json
**/*.qcow2
**/*.iso
**/*.dmg
